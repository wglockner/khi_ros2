# TKrnxPanelInfo (KRNX API Manual 9.5). Raw controller values.
int16 error_lamp       # 0: normal, -1: error
int16 motor_lamp       # 0: motor power off, -1: on
int16 cycle_lamp       # 0: cycle start off, -1: on
int16 repeat_lamp      # 0: teach mode, 1: repeat mode
int16 run_lamp         # 0: hold, 1: run
int16 trigger_lamp     # 0: trigger off, -1: on
int16 teach_lock_lamp  # 0: teach lock off, 1: on
int16 emergency        # 0: emergency stop off, 1: on
